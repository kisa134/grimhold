// level.js — handcrafted castle blockout: geometry, AABB colliders, floor rects,
// torch lights, loot/enemy spawn tables, extraction gate.
//
// Map flow: spawn room -> corridor A -> courtyard (arena) -> corridor B ->
// great hall (pillars, Gate Warden boss, relic) -> stairs down -> dungeon
// (skeletons, treasure room) ... plus corridor loop C back to spawn.
// Extraction gate sits in the north wall of the spawn room.
import * as THREE from "/node_modules/.vite/deps/three.js?v=66ccf562";

export function buildLevel(scene) {
  const colliders = [];   // {min:{x,y,z}, max:{x,y,z}, active}
  const floors = [];      // {x1,z1,x2,z2,y}
  const torches = [];     // {light, base, phase}

  const mats = {
    stone: new THREE.MeshLambertMaterial({ color: 0x3b4048 }),
    dark:  new THREE.MeshLambertMaterial({ color: 0x2a2d34 }),
    floor: new THREE.MeshLambertMaterial({ color: 0x33363f }),
    wood:  new THREE.MeshLambertMaterial({ color: 0x453318 }),
    gate:  new THREE.MeshLambertMaterial({ color: 0x54422a }),
  };

  // addBox: center x/z, base y. Returns {mesh, collider}.
  function addBox(cx, yBase, cz, w, h, d, mat, collide = true) {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(cx, yBase + h / 2, cz);
    scene.add(mesh);
    let col = null;
    if (collide) {
      col = {
        min: { x: cx - w / 2, y: yBase, z: cz - d / 2 },
        max: { x: cx + w / 2, y: yBase + h, z: cz + d / 2 },
        active: true,
      };
      colliders.push(col);
    }
    return { mesh, collider: col };
  }

  function wallSeg(x1, z1, x2, z2, h, yBase = 0, mat = mats.stone) {
    const cx = (x1 + x2) / 2, cz = (z1 + z2) / 2;
    const w = Math.max(Math.abs(x2 - x1), 0.7);
    const d = Math.max(Math.abs(z2 - z1), 0.7);
    return addBox(cx, yBase, cz, w, h, d, mat);
  }

  // Subtract sorted gaps [[a,b],...] from interval [a,b]
  function segs(a, b, gaps) {
    const out = [];
    let cur = a;
    for (const [g1, g2] of (gaps || [])) {
      if (g1 > cur) out.push([cur, g1]);
      cur = Math.max(cur, g2);
    }
    if (cur < b) out.push([cur, b]);
    return out;
  }

  // Rectangular room: floor + 4 walls with optional gaps.
  // gaps: { N:[[a,b]], S:[...], E:[...], W:[...] } measured along the wall axis.
  function room(x1, z1, x2, z2, h, opts = {}) {
    const { floorY = 0, noCeil = false, gaps = {}, skipFloor = false, mat = mats.stone } = opts;
    if (!skipFloor) {
      addBox((x1 + x2) / 2, floorY - 0.5, (z1 + z2) / 2, x2 - x1, 0.5, z2 - z1, mats.floor);
      floors.push({ x1, z1, x2, z2, y: floorY });
    }
    if (!noCeil) addBox((x1 + x2) / 2, floorY + h, (z1 + z2) / 2, x2 - x1, 0.5, z2 - z1, mats.dark, false);
    for (const [a, b] of segs(x1, x2, gaps.N)) wallSeg(a, z1, b, z1, h, floorY, mat);
    for (const [a, b] of segs(x1, x2, gaps.S)) wallSeg(a, z2, b, z2, h, floorY, mat);
    for (const [a, b] of segs(z1, z2, gaps.W)) wallSeg(x1, a, x1, b, h, floorY, mat);
    for (const [a, b] of segs(z1, z2, gaps.E)) wallSeg(x2, a, x2, b, h, floorY, mat);
  }

  function pillar(x, z, h, floorY = 0) {
    addBox(x, floorY, z, 1.1, h, 1.1, mats.dark);
    addBox(x, floorY + h - 0.4, z, 1.5, 0.4, 1.5, mats.dark, false);
  }

  function torch(x, y, z) {
    addBox(x, y, z, 0.12, 0.3, 0.12, mats.wood, false);
    const flame = new THREE.Mesh(
      new THREE.BoxGeometry(0.16, 0.22, 0.16),
      new THREE.MeshLambertMaterial({ color: 0xff8830, emissive: 0xcc5500 })
    );
    flame.position.set(x, y + 0.4, z);
    scene.add(flame);
    const light = new THREE.PointLight(0xff7722, 38, 16, 2);
    light.position.set(x, y + 0.55, z);
    scene.add(light);
    torches.push({ light, base: 38, phase: Math.random() * 10 });
  }

  // ---------- LAYOUT ----------
  // 1. Spawn room: x[-5,5], z[-5,5]
  room(-5, -5, 5, 5, 4, {
    gaps: { E: [[-1.2, 1.2]], N: [[-1.5, 1.5]], S: [[-2.8, -1.2]] },
  });

  // 2. Gate chamber (extraction): x[-3,3], z[-9,-5]
  room(-3, -9, 3, -5, 4, { gaps: { S: [[-1.5, 1.5]] } });
  torch(-2.5, 1.6, -7); torch(2.5, 1.6, -7);

  // Extraction gate (slides into the floor when open)
  const gateBox = addBox(0, 0, -5, 3.0, 3.4, 0.5, mats.gate);
  const gate = { mesh: gateBox.mesh, collider: gateBox.collider, open: false, x: 0, z: -5 };
  // Extraction rune circle
  const rune = new THREE.Mesh(
    new THREE.CircleGeometry(1.2, 20),
    new THREE.MeshBasicMaterial({ color: 0x882222, transparent: true, opacity: 0.7 })
  );
  rune.rotation.x = -Math.PI / 2;
  rune.position.set(0, 0.03, -7);
  scene.add(rune);

  // 3. Corridor A: x[5,13], z[-1.5,1.5]
  room(5, -1.5, 13, 1.5, 3.5, { gaps: { W: [[-1.2, 1.2]], E: [[-1.2, 1.2]] } });
  torch(9, 1.6, -1.1);

  // 4. Courtyard (open arena): x[13,37], z[-12,12]
  room(13, -12, 37, 12, 6, {
    noCeil: true,
    gaps: { W: [[-1.2, 1.2]], N: [[23, 27]], S: [[17, 19]] },
  });
  pillar(17, -8, 6); pillar(33, -8, 6); pillar(17, 8, 6); pillar(33, 8, 6);
  torch(15, 2.2, 0); torch(35, 2.2, 0); torch(25, 2.2, -11); torch(25, 2.2, 11);
  // well / centerpiece rubble
  addBox(25, 0, 3, 2.2, 1.0, 2.2, mats.dark);

  // 5. Corridor B: x[23,27], z[-20,-12]
  room(23, -20, 27, -12, 4, { gaps: { N: [[23.5, 26.5]], S: [[23.5, 26.5]] } });
  torch(25, 1.6, -16);

  // 6. Great hall: x[15,35], z[-38,-20], stair hole x[31,35] z[-34,-28]
  room(15, -38, 35, -20, 7, {
    noCeil: true, skipFloor: true,
    gaps: { S: [[23, 27]] },
  });
  // hall floor pieces (leave stair hole)
  addBox(23, -0.5, -29, 16, 0.5, 18, mats.floor);          // x[15,31] z[-38,-20]
  floors.push({ x1: 15, z1: -38, x2: 31, z2: -20, y: 0 });
  addBox(33, -0.5, -36, 4, 0.5, 4, mats.floor);            // x[31,35] z[-38,-34]
  floors.push({ x1: 31, z1: -38, x2: 35, z2: -34, y: 0 });
  addBox(33, -0.5, -24, 4, 0.5, 8, mats.floor);            // x[31,35] z[-28,-20]
  floors.push({ x1: 31, z1: -28, x2: 35, z2: -20, y: 0 });
