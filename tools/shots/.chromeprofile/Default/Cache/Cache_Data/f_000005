  }
  // shaft walls
  wallSeg(31, -34, 31, -28, 6, -6, mats.dark);  // west side
  wallSeg(31, -34, 35, -34, 6, -6, mats.dark);  // top (north) side
  // south face at z=-28, leaving the dungeon doorway x[32,34] below y=-2.5
  wallSeg(31, -28, 32, -28, 6, -6, mats.dark);
  wallSeg(34, -28, 35, -28, 6, -6, mats.dark);
  wallSeg(32, -28, 34, -28, 2.5, -2.5, mats.dark);
  torch(31.5, -2.5, -31);

  // 8. Dungeon: x[31,47], z[-28,-16], floor -6
  room(31, -28, 47, -16, 3.5, { floorY: -6, gaps: { N: [[32, 34]] } });
  // treasure-room partition at x=41, gap z[-19.5,-17.5]
  wallSeg(41, -28, 41, -19.5, 3.5, -6, mats.dark);
  wallSeg(41, -17.5, 41, -16, 3.5, -6, mats.dark);
  torch(33, -4, -18); torch(39, -4, -26); torch(45, -4, -18);
  // prison bars decoration
  addBox(31.5, -6, -20, 0.4, 3.5, 3, mats.dark);

  // 9. Corridor loop C (ambush route back to spawn)
  // C1: x[17,19], z[12,24]
  room(17, 12, 19, 24, 4, { gaps: { N: [[17, 19]], S: [[17, 19]] } });
  torch(18, 1.6, 18);
  // C2: x[-3,19], z[24,28]
  room(-3, 24, 19, 28, 4, { gaps: { N: [[-3, -1], [17, 19]], W: [[24, 28]] } });
  torch(8, 1.6, 26);
  // C3: x[-3,-1], z[5,24]
  room(-3, 5, -1, 24, 4, { gaps: { N: [[-3, -1]], S: [[-3, -1]] } });
  torch(-2, 1.6, 14);

  // 10. TRAINING ROOM — a detached torch-lit stone hall far to the east
  // (beyond fog range; shares the collider/floor arrays so all physics,
  // gore decals and ragdolls work unchanged).
  room(108, -10, 128, 10, 5.5, {});
  pillar(112, -6, 5.5); pillar(124, -6, 5.5); pillar(112, 6, 5.5); pillar(124, 6, 5.5);
  torch(110, 1.8, -8); torch(126, 1.8, -8); torch(110, 1.8, 8); torch(126, 1.8, 8);
  torch(118, 1.8, -9); torch(118, 1.8, 9);
  // weapon racks + straw-mat sparring circle, pure GRIMHOLD dressing
  addBox(109, 0, -3, 0.5, 1.7, 2.6, mats.wood);
  addBox(109, 0, 3, 0.5, 1.7, 2.6, mats.wood);
  const sparMat = new THREE.MeshLambertMaterial({ color: 0x4a3d28 });
  addBox(118, 0, 0, 9, 0.06, 9, sparMat, false);
  floors.push({ x1: 113.5, z1: -4.5, x2: 122.5, z2: 4.5, y: 0.06 });

  const training = {
    spawn: { x: 118, z: 6.5, yaw: 0 },  // facing the dummies on the mat
    dummySpawns: [
      { type: 'bandit', x: 114.5, z: -2.5 },
      { type: 'bandit', x: 114.5, z: 2.5 },
      { type: 'skeleton', x: 121.5, z: -2.5 },
      { type: 'knight', x: 121.5, z: 2.5 },
    ],
  };

  // ---------- SPAWN TABLES ----------
  const lootSpawns = [
    { x: 20, z: 8,   table: 'gold' },
    { x: 30, z: -8,  table: 'gold' },
    { x: 25, z: 10,  table: 'weapon' },
    { x: 25, z: -16, table: 'gold' },
    { x: 18, z: -24, table: 'gold' },
    { x: 30, z: -22, table: 'armor' },
    { x: 25, z: -35.5, y: 0.4, table: 'relic' },
    { x: 28, z: -35, table: 'gold' },
    { x: 35, z: -24, y: -6, table: 'gold' },
    { x: 44, z: -22, y: -6, table: 'relic' },
    { x: 44, z: -19, y: -6, table: 'cursed' },
    { x: 10, z: 26,  table: 'armor' },
    { x: -2, z: 14,  table: 'gold' },
  ];

  const enemySpawns = [
    { type: 'bandit', x: 20, z: -4 },
    { type: 'bandit', x: 30, z: 6 },
    { type: 'bandit', x: 25, z: 5 },    // courtyard reinforcement
    { type: 'skeleton', x: 33, z: -6 }, // courtyard reinforcement
    { type: 'knight', x: 28, z: -2 },
    { type: 'bandit', x: 9, z: 0 },     // corridor A lurker
    { type: 'bandit', x: 18, z: 20 },   // corridor C ambush
    { type: 'bandit', x: -2, z: 20 },   // corridor C3 stalker
    { type: 'bandit', x: 18, z: -30 },  // great hall
    { type: 'knight', x: 25, z: -30, boss: true }, // Gate Warden
    { type: 'skeleton', x: 36, z: -22 },
    { type: 'skeleton', x: 44, z: -20 },
    { type: 'skeleton', x: 44, z: -24 }, // dungeon reinforcement
  ];

  // ---------- QUERIES ----------
  function floorHeightAt(x, z, refY) {
    let best = -Infinity;
    for (const f of floors) {
      if (x >= f.x1 - 0.05 && x <= f.x2 + 0.05 && z >= f.z1 - 0.05 && z <= f.z2 + 0.05) {
        if (f.y <= refY + 0.55 && f.y > best) best = f.y;
      }
    }
    return best === -Infinity ? refY : best;
  }

  // Push a circle (x/z) out of active colliders spanning the given height.
  function collideCircle(pos, radius, height) {
    for (const c of colliders) {
      if (!c.active) continue;
      if (c.max.y < pos.y + 0.3 || c.min.y > pos.y + height) continue;
      const cx = Math.max(c.min.x, Math.min(pos.x, c.max.x));
      const cz = Math.max(c.min.z, Math.min(pos.z, c.max.z));
      const dx = pos.x - cx, dz = pos.z - cz;
      const d2 = dx * dx + dz * dz;
      if (d2 >= radius * radius) continue;
      if (d2 > 1e-8) {
        const d = Math.sqrt(d2);
        pos.x = cx + (dx / d) * radius;
        pos.z = cz + (dz / d) * radius;
      } else {
        // center inside the box: push along smallest penetration axis
        const px = Math.min(pos.x - c.min.x + radius, c.max.x - pos.x + radius);
        const pz = Math.min(pos.z - c.min.z + radius, c.max.z - pos.z + radius);
        if (px < pz) pos.x += (pos.x - (c.min.x + c.max.x) / 2 > 0) ? px : -px;
        else pos.z += (pos.z - (c.min.z + c.max.z) / 2 > 0) ? pz : -pz;
      }
    }
  }

  // Ray vs collider AABBs (slab test), horizontal-ish rays for wall splats.
  // Returns {point, normal, dist} of the nearest hit or null.
  function raycastWall(origin, dir, maxDist) {
    let best = null;
    for (const c of colliders) {
      if (!c.active) continue;
      let tmin = 0, tmax = maxDist;
      let nAxis = -1, nSign = 0;
      let ok = true;
      for (const [axis, o, d, mn, mx] of [
        ['x', origin.x, dir.x, c.min.x, c.max.x],
        ['y', origin.y, dir.y, c.min.y, c.max.y],
        ['z', origin.z, dir.z, c.min.z, c.max.z],
      ]) {
        if (Math.abs(d) < 1e-8) {
          if (o < mn || o > mx) { ok = false; break; }
          continue;
        }
        let t1 = (mn - o) / d, t2 = (mx - o) / d;
        let sign = -1;
        if (t1 > t2) { const tt = t1; t1 = t2; t2 = tt; sign = 1; }
        if (t1 > tmin) { tmin = t1; nAxis = axis; nSign = sign; }
        tmax = Math.min(tmax, t2);
        if (tmin > tmax) { ok = false; break; }
      }
      if (!ok || tmin <= 0.01 || tmin >= maxDist) continue;
      if (!best || tmin < best.dist) {
        const normal = { x: 0, y: 0, z: 0 };
        if (nAxis !== -1) normal[nAxis] = nSign;
        best = {
          dist: tmin,
          point: new THREE.Vector3(origin.x + dir.x * tmin, origin.y + dir.y * tmin, origin.z + dir.z * tmin),
          normal: new THREE.Vector3(normal.x, normal.y, normal.z),
        };
      }
    }
    return best;
  }

  // Ambush trigger volumes: crossing one spawns surprises (once per run).
  const ambushVolumes = [
    // corridor C elbow — skeletons burst out of the dark
    { x1: 4, z1: 22, x2: 14, z2: 28, triggered: false,
      spawns: [{ type: 'skeleton', x: 8, z: 26, rise: true }, { type: 'skeleton', x: 12, z: 25, rise: true }] },
    // great hall entrance — a skeleton claws up from the floor
    { x1: 22, z1: -26, x2: 28, z2: -21, triggered: false,
      spawns: [{ type: 'skeleton', x: 25, z: -24, rise: true }] },
    // dungeon approach — bone horror rises at the stair base
    { x1: 31.5, z1: -30, x2: 35, z2: -27, triggered: false,
      spawns: [{ type: 'skeleton', x: 33, z: -24, rise: true }, { type: 'skeleton', x: 37, z: -22, rise: true }] },
  ];

  return {
    colliders, floors, torches, lootSpawns, enemySpawns, ambushVolumes,
    gate, rune, training,
    spawn: { x: 0, z: 2, yaw: 0 },
    extractPos: { x: 0, z: -7 },
    floorHeightAt, collideCircle, raycastWall,
  };
}

