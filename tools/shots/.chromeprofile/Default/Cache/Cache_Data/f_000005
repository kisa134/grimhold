  // treasure dais at the north end
  addBox(25, 0, -35.5, 4, 0.4, 2.4, mats.wood);
  floors.push({ x1: 23, z1: -36.7, x2: 27, z2: -34.3, y: 0.4 });

  // 7. Stair shaft down: x[31,35], z[-34,-28], y 0 -> -6 (12 steps)
  const steps = 12, drop = 0.5, run = 6 / steps;
  for (let i = 0; i < steps; i++) {
    const topY = -(i + 1) * drop;
    const zA = -34 + i * run, zB = zA + run;
    addBox(33, topY - 0.5, (zA + zB) / 2, 4, 0.5, run, mats.floor);
